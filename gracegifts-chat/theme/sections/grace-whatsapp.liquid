{% assign n = section.settings.number | remove: '+' | remove: ' ' %}
{%- assign occ = '' -%}{%- for c in collections -%}{%- if c.products_count > 0 and c.handle != 'frontpage' and c.handle != 'build-items' -%}{%- assign occ = occ | append: c.title | append: '|' | append: c.url | append: ';' -%}{%- endif -%}{%- endfor -%}
<style>.wa{background:#C08A8A;border:0;cursor:pointer;width:54px;height:54px;padding:0;border-radius:50%;display:flex;align-items:center;justify-content:center;transition:transform .2s}.wa:hover{transform:scale(1.08)}.wa svg{width:28px;height:28px;fill:none;stroke:#fff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.gc{position:fixed;right:18px;bottom:84px;z-index:200;width:min(380px,calc(100vw - 24px));height:min(560px,calc(100vh - 110px));background:#FFFDF9;color:#2B2623;border:1px solid #E9E3DB;border-radius:18px;box-shadow:0 20px 50px rgba(0,0,0,.25);display:none;flex-direction:column;overflow:hidden;font-size:14px}.gc.open{display:flex}.gc__h{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;background:#FBEFEC;border-bottom:1px solid #EFE6DA}.gc__h b{font-family:Georgia,serif;font-weight:400;font-size:17px;display:block}.gc__h span{font-size:12px;color:#8F7070}.gc__h button{border:0;background:none;font-size:24px;cursor:pointer;color:#8F7070}.gc__n{font-size:11px;color:#8A7F76;padding:6px 14px;background:#FFF9F0;border-bottom:1px solid #F3EADD}.gc__m{flex:1;overflow:auto;padding:12px;display:flex;flex-direction:column;gap:8px}.gm{max-width:86%;padding:9px 12px;border-radius:14px;line-height:1.45;white-space:pre-wrap;overflow-wrap:anywhere}.gm.bot{background:#fff;border:1px solid #E9E3DB;align-self:flex-start;border-bottom-left-radius:4px}.gm.user{background:#E8B4B8;color:#4A2F2F;align-self:flex-end;border-bottom-right-radius:4px}.gm.wait{opacity:.6}.gm a{text-decoration:underline;color:inherit}.gc__q{display:flex;flex-wrap:wrap;gap:6px;padding:0 12px 10px}.gc__q button{border:1px solid #E3DAD0;background:#fff;border-radius:16px;padding:6px 12px;font-size:12px;cursor:pointer;color:#2B2623}.gc__q button:hover{background:#C9A27A}.gc__f{display:flex;gap:8px;padding:10px 12px;border-top:1px solid #EFE6DA}.gc__f input{flex:1;padding:10px 12px;border:1px solid #D8CFC4;border-radius:12px;font:inherit;background:#fff;color:#2B2623}.gc__f button{border:0;background:#C9A27A;color:#2B2623;font-weight:600;border-radius:12px;padding:0 14px;cursor:pointer}.gc__f button:disabled{opacity:.5;cursor:wait}.gc__t{display:flex;justify-content:space-between;gap:8px;padding:0 14px 10px;font-size:12px}.gc__t a{color:#25603A;text-decoration:underline}.gc__t a+a{color:#8A7F76}@media(max-width:800px){.wa{bottom:78px}.gc{right:12px;left:12px;width:auto;bottom:142px;height:min(520px,calc(100vh - 170px))}}</style>
<button class='wa' type='button' id='gcb' aria-label='Chat with us' aria-expanded='false'><svg viewBox='0 0 24 24' aria-hidden='true'><path d='M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H9l-5 4V6a1 1 0 0 1 1-1z'/><path d='M8 10.5h8M8 13.5h5'/></svg></button>
<div class='gc' id='gc' role='dialog' aria-label='Grace Gifts assistant' data-ep='{{ section.settings.endpoint | escape }}' data-greet='{{ section.settings.greeting | escape }}' data-occ='{{ occ | escape }}' data-wa='{{ n }}'>
<div class='gc__h'><div><b>Grace Gifts assistant</b><span>{% if section.settings.endpoint != blank %}Ask about our gifts, prices, delivery and more{% else %}Ask about delivery, returns, customising and more{% endif %}</span></div><button type='button' id='gcx' aria-label='Close chat'>&times;</button></div>
<div class='gc__n'>{% if section.settings.endpoint != blank %}I am an AI assistant and can make mistakes. For orders, refunds or anything important, please check with our team.{% else %}Quick answers to common questions. For anything else, chat to our team on WhatsApp.{% endif %}</div>
<div class='gc__m' id='gcm' role='log' aria-live='polite'></div>
<div class='gc__q' id='gcq'>{% if section.settings.endpoint != blank %}<button type='button'>Help me choose a gift</button><button type='button'>What is in each basket?</button>{% endif %}<button type='button'>Delivery</button><button type='button'>Returns</button><button type='button'>Custom designs</button><button type='button'>Payments</button><button type='button'>Gift wrapping</button><button type='button'>Track my order</button></div>
<form class='gc__f' id='gcf'><input id='gci' type='text' maxlength='500' placeholder='Type your question' autocomplete='off' aria-label='Your question'><button type='submit' id='gcs'>Send</button></form>
<div class='gc__t'><a href='https://wa.me/{{ n }}' target='_blank' rel='noopener'>Talk to a person on WhatsApp</a><a href='/pages/privacy-policy'>Privacy</a></div>
</div>
<script>(function(){var b=document.getElementById('gcb'),p=document.getElementById('gc');if(!b||!p)return;var EP=p.getAttribute('data-ep')||'',m=document.getElementById('gcm'),q=document.getElementById('gcq'),f=document.getElementById('gcf'),inp=document.getElementById('gci'),sb=document.getElementById('gcs'),hist=[],sent=0,busy=false;try{hist=JSON.parse(sessionStorage.getItem('gc_h')||'[]');sent=+sessionStorage.getItem('gc_n')||0}catch(e){hist=[]}
var OCC=(p.getAttribute('data-occ')||'').split(';').filter(Boolean).map(function(s){return s.split('|')});
var SHOP=OCC.length?OCC[0][1]:'/collections/all';
var WA='+'+(p.getAttribute('data-wa')||'27799796443');
var occAns=OCC.length?'Right now we have gift sets for '+OCC.map(function(o){return o[0]}).join(', ')+'. More occasions are coming soon. '+OCC.map(function(o){return o[1]}).join(' '):'Please message our team on WhatsApp and we will help you choose a gift.';
/* Checked in order; the entry with the most keyword matches wins, ties go to the earlier entry. Keywords match the start of a word; a trailing space makes one match a whole word only. */
var KB=[
{k:['custom','personalis','personaliz','embroider','monogram','name on'],a:`Items marked Customise have a form on the product page: type your text, choose a colour and see a preview. A custom design is made just for you, so it cannot be returned or refunded if you change your mind or are not happy with the design you chose. If it is faulty, unsafe or not as described, or we make a mistake, we will put it right. /pages/returns`},
{k:['cancel','my order','change the name','change my order','change the order','edit my order','wrong address','change my address','change the address'],a:`Please message our team on WhatsApp (${WA}) as soon as possible with your order number, and we will help. You can read about your cancellation rights on our returns page. /pages/returns`},
{k:['damaged','broken','faulty','not as described','wrong item','missing','arrived damaged'],a:`Sorry to hear that. If something is faulty, damaged, unsafe, the wrong item or not as described, tell us within 6 months of delivery and choose a repair, a replacement or a refund. We pay the courier to get it back, and if you choose a refund we also refund the delivery fee. Please send us your order number and a photo. /pages/contact`},
{k:['return','refund','change my mind','mind ','money back','exchange'],a:`If you change your mind, you have 7 days from receiving your order to cancel and return the goods, for a refund or an exchange. You pay the return courier and the delivery fee is not refunded. If something is faulty, unsafe or not as described, you have 6 months to choose a repair, replacement or refund, and we pay the courier. Custom designs cannot be returned or refunded for a change of mind. /pages/returns`},
{k:['track','where is my','order status','shipped','my order','tracking'],a:`When your order ships, we email you the tracking details. Our gifts are made to order, so please allow 10 to 15 business days from payment. For an existing order, please message our team on WhatsApp with your order number. /pages/track-your-order`},
{k:['eft ','bank transfer','electronic transfer','deposit'],a:`Our checkout takes Visa, Mastercard and American Express, and Apple Pay or Google Pay on supported devices, through Yoco. If you need to pay another way, please message our team on WhatsApp. /pages/how-to-pay`},
{k:['voucher','gift card','gift certificate'],a:`We do not have gift vouchers in the shop at the moment. Please message our team on WhatsApp if you would like to ask about one.`},
{k:['pay','payment','credit card','debit card','visa','mastercard','amex','american express','apple pay','google pay','yoco','secure'],a:`We use Yoco to take payment securely. You can pay with Visa, Mastercard or American Express, and Apple Pay or Google Pay on supported devices. The options available to you are shown at checkout. We never see or store your card details. /pages/how-to-pay`},
{k:['wrap','message','note','ribbon','card'],a:`You can add gift wrapping (the price is shown before you pay) and a gift message of up to 200 characters on each product page. In your cart you can also leave a note for the whole order. /pages/gift-wrapping-and-messages`},
{k:['safe','safety','allerg','sensitive skin','wash','care '],a:`Please see our safety and care information. If you have a question about the materials in a gift, ask our team before you order. /pages/safety-and-care`},
{k:['deliver','shipping','ship','how long','arrive','courier','dispatch','by friday','by monday','in time','urgent'],a:`Delivery is a flat R120 anywhere in South Africa, and free on orders over R1,500. Our gifts are made to order, so please allow 10 to 15 business days from payment, depending on stock availability. We deliver only within South Africa. If you need a gift by a certain date, please ask our team on WhatsApp before you order. /pages/delivery`},
{k:['discount','code','coupon','welcome5','gift club','specials','sale '],a:`Join the Gift Club on our homepage for 5% off your first order. Enter the code WELCOME5 at checkout. It can be used once per customer and cannot be combined with other codes. /pages/gift-club-terms`},
{k:['where are you','based','located','location','collect','pick up','pickup','address'],a:`We are based in Krugersdorp, Gauteng, and deliver by courier anywhere in South Africa. If you would like to collect, please ask our team on WhatsApp first. /pages/contact`},
{k:['contact','phone','call','whatsapp','email','speak','talk','human','person'],a:`You can message or call us on ${WA} (WhatsApp), or use our contact page. /pages/contact`},
{k:['price','how much','cost','basket','inside','included','what s in','stock','available','recommend','choose','suggest','help me'],a:`Each gift page shows the price, the options and exactly what is inside. Have a look here: ${SHOP} For help choosing, message our team on WhatsApp at ${WA}.`},
{k:['baby','shower','kitchen','tea ','teas ','bridal','bride','bridesmaid','groomsm','housewarming','house warming','birthday','16th','18th','21st','30th','40th','50th','60th','70th','occasion','gift set','what do you sell','what do you have'],a:occAns},
{k:['hi ','hello','hey ','howzit','good morning','good afternoon','good evening'],a:`Hello! I can help with delivery, returns, customising, payments and gift wrapping. What would you like to know?`},
{k:['thank','thanks','cheers','great','perfect'],a:`It is a pleasure! Is there anything else I can help with?`}];
var DEF=`I am not sure about that one. Please message our team on WhatsApp at ${WA} and we will gladly help.`;
function fill(d,t){var re=/(\/(?:pages|collections|products)\/[a-z0-9-]+|https:\/\/[^\s)]+)/g;t.split(re).forEach(function(s,i){if(i%2===1){var a=document.createElement('a');a.href=s;a.textContent=s.charAt(0)!=='/'?s:s.indexOf('/products/')===0?'View product':s.indexOf('/collections/')===0?'Browse':'Read more';d.appendChild(document.createTextNode(' '));d.appendChild(a)}else if(s){d.appendChild(document.createTextNode(s))}})}
function mk(role,t){var d=document.createElement('div');d.className='gm '+role;fill(d,t);m.appendChild(d);m.scrollTop=m.scrollHeight;return d}
function save(){try{sessionStorage.setItem('gc_h',JSON.stringify(hist.slice(-20)));sessionStorage.setItem('gc_n',String(sent))}catch(e){}}
function guided(t){var s=' '+t.toLowerCase().replace(/[^a-z0-9%]+/g,' ').trim()+' ',best=null,top=0;for(var i=0;i<KB.length;i++){var n=0;for(var j=0;j<KB[i].k.length;j++){if(s.indexOf(' '+KB[i].k[j])>-1)n++}if(n>top){top=n;best=KB[i].a}}return best||DEF}
function ask(t){t=(t||'').trim();if(!t||busy)return;if(EP&&sent>=25){mk('bot',`We have chatted a lot. For anything more, please message our team on WhatsApp at ${WA}.`);return}sent++;busy=true;sb.disabled=true;q.style.display='none';mk('user',t);hist.push({role:'user',content:t});save();inp.value='';var w=mk('bot','...');w.classList.add('wait');function done(r){busy=false;sb.disabled=false;w.classList.remove('wait');w.textContent='';fill(w,r);m.scrollTop=m.scrollHeight;hist.push({role:'assistant',content:r});save()}if(!EP){setTimeout(function(){done(guided(t))},350);return}var ac=window.AbortController?new AbortController():null,tm=setTimeout(function(){if(ac)ac.abort()},30000);fetch(EP,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({messages:hist.slice(-12),page:location.pathname}),signal:ac?ac.signal:undefined}).then(function(r){if(!r.ok)throw 0;return r.json()}).then(function(d){clearTimeout(tm);done(d.reply||guided(t))}).catch(function(){clearTimeout(tm);done(guided(t))})}
if(hist.length){q.style.display='none';hist.forEach(function(h){mk(h.role==='user'?'user':'bot',h.content)})}else{mk('bot',p.getAttribute('data-greet')||'Hello! How can I help?')}
q.querySelectorAll('button').forEach(function(x){x.addEventListener('click',function(){ask(x.textContent)})});f.addEventListener('submit',function(e){e.preventDefault();ask(inp.value)});function tog(o){var was=p.classList.contains('open'),open=o===undefined?!was:o;p.classList.toggle('open',open);b.setAttribute('aria-expanded',open);if(open)inp.focus();else if(was)b.focus()}b.addEventListener('click',function(){tog()});document.getElementById('gcx').addEventListener('click',function(){tog(false)});document.addEventListener('keydown',function(e){if(e.key==='Escape'&&p.classList.contains('open'))tog(false)})})();</script>
{% schema %}{"name":"Chat assistant","settings":[{"type":"text","id":"endpoint","label":"AI chat server address (leave blank to use the guided assistant)"},{"type":"text","id":"greeting","label":"Greeting","default":"Hello! I can help with delivery, returns, customising, payments and more. What would you like to know?"},{"type":"text","id":"number","label":"WhatsApp number with country code","default":"27799796443"}]}{% endschema %}
